#!/usr/bin/env bash
# Weigert commits met lokale/gegenereerde bestanden of persoonlijke paden (B-17).
# Activeren (eenmalig per clone): git config core.hooksPath .githooks
set -uo pipefail
bad=0
fail(){ echo "pre-commit: $*" >&2; bad=1; }
for f in .devcontainer/devcontainer.json .devcontainer/tst.code-workspace repos.conf repo-root.conf; do
  git ls-files --error-unmatch "$f" >/dev/null 2>&1 && fail "$f hoort niet in git (lokaal/gegenereerd; zie .gitignore)"
done
# Geen grep -q in pipes: met pipefail geeft een vroeg stoppende grep SIGPIPE en dus een valse uitkomst.
tpl=$(git show :.devcontainer/devcontainer.template.jsonc 2>/dev/null || true)
grep -F '"AGENT_REPOS": "voorbeeld-repo"' <<<"$tpl" >/dev/null || fail "devcontainer.template.jsonc moet het voorbeeld-repo-blok houden"
added=$(git diff --cached -U0 | grep '^+' || true)
grep -F -- "$HOME" <<<"$added" >/dev/null && fail "toegevoegde regels bevatten je home-pad ($HOME)"
if [ $bad = 1 ]; then
  echo "Oplossing: gegenereerde/lokale bestanden uit de index halen (git rm --cached <bestand>) of persoonlijke paden verwijderen, en commit opnieuw." >&2
  exit 1
fi
exit 0
