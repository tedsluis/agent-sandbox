{
  // Deze map (~/agent-sandbox) wordt NIET in de container gemount.
  // De agent kan deze configuratie dus niet aanpassen om extra mounts toe te voegen.
  "name": "agent-sandbox",
  "build": {
    "dockerfile": "Containerfile",
    // Host-UID/GID uit code-agent.sh (B-17); met keep-id is de container-UID gelijk aan de host-UID.
    "args": { "USER_UID": "${localEnv:AGENT_UID:1000}", "USER_GID": "${localEnv:AGENT_GID:1000}" }
  },

  // Alleen de repo's uit repos.conf (kiezen met select-repos.sh; bronmap uit repo-root.conf, standaard ~/git), niet de bronmap als geheel en niet je home directory.
  // ",z" = gedeelde SELinux-label (container_file_t), zodat de host en de container erbij kunnen.
  // BEGIN repos (gegenereerd door select-repos.sh – niet met de hand aanpassen)
  "workspaceMount": "source=${localEnv:HOME}/git/voorbeeld-repo,target=/workspaces/voorbeeld-repo,type=bind,z",
  "mounts": [],
  "workspaceFolder": "/workspaces/voorbeeld-repo",
  "containerEnv": { "AGENT_REPOS": "voorbeeld-repo" },
  // END repos

  // Draait op de HOST vóór elke start/koppeling: weigert als VS Code niet via code-agent.sh (env -i) is gestart.
  "initializeCommand": "${localWorkspaceFolder}/guard-host-env.sh",

  "remoteUser": "agent",
  "containerUser": "agent",
  "updateRemoteUserUID": false,

  // Geen --userns hier: de devcontainers CLI zet zelf --userns=keep-id (remoteUser is niet root),
  // een tweede --userns conflicteert. Host-UID = agent-UID (build.args hierboven).
  "runArgs": [
    "--cap-drop=ALL",
    "--security-opt=no-new-privileges",
    "--pids-limit=1024",
    "--hostname=agent-sandbox"
  ],

  // Vangnet: ook als VS Code toch een agent-socket of gitconfig zou doorgeven.
  "remoteEnv": {
    "SSH_AUTH_SOCK": "",
    "DISPLAY": "",
    "WAYLAND_DISPLAY": "",
    "XDG_RUNTIME_DIR": "",
    "BROWSER": "",
    "GIT_TERMINAL_PROMPT": "0",
    "KUBECONFIG": "/dev/null"
  },

  "customizations": {
    "vscode": {
      // Copilot Chat is ingebouwd in stable (0.74) en Insiders (0.75); niet van de Marketplace installeren (gaf 0.48.1)
      "extensions": ["redhat.vscode-yaml"],
      "settings": {
        "terminal.integrated.inheritEnv": false,
        // Geen askpass/GitHub-token via de VS Code git-extensie naar git in de terminal
        "git.terminalAuthentication": false,
        "github.gitAuthentication": false,
        "chat.tools.terminal.autoApprove": {
          "/^kustomize build\\b/": true,
          "/^yamllint\\b/": true,
          "/^(grep|rg|find|ls|cat|head|tail|diff)\\b/": true,
          "/^git (status|diff|log)\\b/": true
        }
      }
    }
  }
}
